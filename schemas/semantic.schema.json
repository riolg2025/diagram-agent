{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riolg2025/diagram-agent/schemas/semantic.schema.json",
  "title": "Semantic Claim",
  "description": "An explicit interpretation of evidence. Semantic claims must remain traceable to evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "claim", "evidence_ids", "confidence", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s-[A-Za-z0-9._-]+$"
    },
    "claim": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^e-[A-Za-z0-9._-]+$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": ["hypothesis", "validated", "rejected", "needs_clarification"]
    },
    "notes": {
      "type": "string"
    }
  }
}

